# Dynamic build symlinks (generated by make_carbon.sh)
/unica/
/target/
/scripts/
/tools/
/platform/
/security/
/prebuilts/

# Build output and symlinks
/out
out/
build/
dist/
**/build/
**/CMakeFiles/
*.img
*.zip

# Allow specific prebuilts in carbon_ours
!carbon_ours/**/*.img
!carbon_ours/**/*.zip
# Ignore monolithic >100MB recovery image; repo tracks split recovery.img.00 / .01
carbon_ours/recovery_twrp/recovery.img

# Carbon Engine build artifacts, caches and databases
*.db
*.db-shm
*.db-wal
.carbon_cache/
CMakeCache.txt
*.a
*.o

# Temporary and log files
*.tmp
*.log
*.bak
*.orig
*.rej

# Private Cryptographic Keys & Secrets (STRICT SECURITY - NEVER COMMIT)
carbon_ours/security_keys/keys/
carbon_ours/security_keys/unica_*
security/keys/
*.pk8
*.key
!carbon_ours/security_keys/aosp_platform.pk8
!carbon_ours/security_keys/aosp_testkey.pk8
!carbon_ours/security_keys/aosp_platform.x509.pem
!carbon_ours/security_keys/aosp_testkey.x509.pem
!carbon_ours/security_keys/avb/testkey_rsa4096.pem

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Claude 
.claude/

# Internal developer docs (strictly local - never commit)
devdocs/
docs/camera_calibration_*.txt
